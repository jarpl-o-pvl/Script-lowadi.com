    renderSettings();

    const hdr = panel.querySelector('#lp-hdr');
    let drag = false, dx = 0, dy = 0;
    hdr.addEventListener('mousedown', e => {
        if (e.target.closest('button')) return;
        drag = true; dx = e.clientX - panel.offsetLeft; dy = e.clientY - panel.offsetTop;
    });
    document.addEventListener('mousemove', e => {
        if (!drag) return;
        panel.style.left = (e.clientX - dx) + 'px'; panel.style.top = (e.clientY - dy) + 'px'; panel.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { drag = false; });
    panel.querySelector('#lp-min').onclick = () => {
        panel.querySelector('#lp-body').style.display = panel.querySelector('#lp-body').style.display === 'none' ? 'block' : 'none';
    };

    // ================= УТИЛИТЫ =================
    function normalize(t) {
        return String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
    }
    function isVisible(el) {
        if (!el || el.closest('#lp-panel')) return false;
        const r = el.getBoundingClientRect(); return r.width > 1 && r.height > 1;
    }
    
    function findTarget(texts) {
        const kws = texts.map(normalize);
        const els = document.querySelectorAll('a, button, .btn, img, input[type="submit"], td, span');
        for (let el of els) {
            if (!el || !isVisible(el)) continue;
            let clickable = el;
            if (el.tagName === 'IMG') clickable = el.closest('a, button, [onclick]') || el;
            if (clickable.disabled || clickable.classList.contains('disabled')) continue;

            let text = normalize(clickable.textContent + ' ' + (clickable.value || '') + ' ' + (clickable.title || ''));
            if (el.tagName === 'IMG') text += ' ' + normalize(el.alt);
            if (clickable.querySelector('img')) {
                clickable.querySelectorAll('img').forEach(img => text += ' ' + normalize(img.alt));
            }

            for (let kw of kws) {
                if (text.includes(kw)) return clickable;
            }
        }
        return null;
    }

    function fireClick(el) {
        try {
            el.scrollIntoView({ block: 'center' });
            const rect = el.getBoundingClientRect();
            const x = rect.left + rect.width / 2;
            const y = rect.top + rect.height / 2;
            const opts = { bubbles: true, cancelable: true, view: window, clientX: x, clientY: y };
            el.dispatchEvent(new MouseEvent('mousedown', opts));
            el.dispatchEvent(new MouseEvent('mouseup', opts));
            el.dispatchEvent(new MouseEvent('click', opts));
        } catch (e) { el.click(); }
    }

    async function setScalePoint(sectionName, targetValue) {
        const targetStr = String(targetValue);
        const normSection = normalize(sectionName);

        let sliders = Array.from(document.querySelectorAll(`[data-number="${targetStr}"]`)).filter(isVisible);

        if (sliders.length === 0) {
            const allPoints = Array.from(document.querySelectorAll('[data-number]')).filter(el => isVisible(el) && !isNaN(parseInt(el.getAttribute('data-number'))));
            if (allPoints.length > 0) {
                allPoints.sort((a, b) => Math.abs(parseInt(a.getAttribute('data-number')) - targetValue) - Math.abs(parseInt(b.getAttribute('data-number')) - targetValue));
                sliders = [allPoints[0]];
            }
        }

        if (sliders.length === 0) return false;

        sliders.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

        if (normSection.includes('корм')) {
            log(`📝 Клик по точке в "${sectionName}" (верхняя)`);
            fireClick(sliders[0]);
            return true;
        } else if (normSection.includes('овес')) {
            const targetEl = sliders[sliders.length - 1];
            log(`📝 Клик по точке в "${sectionName}" (нижняя)`);
            fireClick(targetEl);
            return true;
        } else {
            log(`📝 Клик по точке ${targetStr} в "${sectionName}"`);
            fireClick(sliders[0]);
            return true;
        }
    }

    // === ИСПРАВЛЕННОЕ ПОДТВЕРЖДЕНИЕ ===
    async function confirmModal() {
        const modals = document.querySelectorAll('.modal, .popup, #messageBox, .messageBox, [role="dialog"], .fancybox-container');
        for (let modal of modals) {
            if (!isVisible(modal)) continue;
            const btns = modal.querySelectorAll('a, button, .btn, input[type="submit"], span.button-inner');
            for (let btn of btns) {
                if (!isVisible(btn)) continue;
                const text = normalize(btn.textContent + ' ' + (btn.value || ''));
                const isConfirmText = text.includes('подтвердить') || text.includes('принять') || text.includes('ок') || text.includes('да') || text.includes('состарить') || text.includes('тренировать') || text.includes('прогулять');
                
                if (isConfirmText) {
                    log(`🔘 Подтверждаю в окне: "${text.slice(0,15)}"`);
                    fireClick(btn);
                    await sleep(settings.delayModal);
                    return true;
                }
            }
        }

        const btns = document.querySelectorAll('a, button, .btn, input[type="submit"]');
        for (let btn of btns) {
            if (!isVisible(btn)) continue;
            const text = normalize(btn.textContent + ' ' + (btn.value || ''));
            if (text === 'играть' || text === 'поить' || text === 'чистить' || text === 'кормить' || text === 'ласкать' || text === 'морковь' || text === 'смесь') continue;

            if (text.includes('подтвердить') || text.includes('принять') || text.includes('состарить')) {
                log(`🔘 Подтверждаю: "${text.slice(0,15)}"`);
                fireClick(btn);
                await sleep(settings.delayModal);
                return true;
            }
        }
        return false;
    }

    // ================= АНАЛИЗ ЭНЕРГИИ И ЗДОРОВЬЯ =================
    function getEnergyLevel() {
        const bodyText = document.body.innerText;
        const match = bodyText.match(/(?:энергия|energy)[^\d]*(\d+)\s*%/i);
        return match ? parseInt(match[1], 10) : 100;
    }

    function getHealthLevel() {
        const bodyText = document.body.innerText;
        const match = bodyText.match(/(?:здоровье|health)[^\d]*(\d+)\s*%/i);
        return match ? parseInt(match[1], 10) : 100;
    }

    // ================= АНАЛИЗ ВОЗРАСТА =================
    function getHorseAge() {
        const bodyText = document.body.innerText;
        const ageMatch = bodyText.match(/Возраст:\s*([^(\n]+)/i);
        if (!ageMatch) return null;
        
        const ageStr = ageMatch[1].toLowerCase();
        
        if (ageStr.includes('час')) return { stage: 'hours' };
        
        if (ageStr.includes('год') || ageStr.includes('лет')) {
            const yMatch = ageStr.match(/(\d+)\s*(год|лет|года)/);
            const mMatch = ageStr.match(/(\d+)\s*мес/);
            return { stage: 'years', years: yMatch ? parseInt(yMatch[1]) : 0, months: mMatch ? parseInt(mMatch[1]) : 0 };
        }
        
        if (ageStr.includes('мес')) {
            const mMatch = ageStr.match(/(\d+)\s*мес/);
            return { stage: 'months', months: mMatch ? parseInt(mMatch[1]) : 0 };
        }
        return null;
    }

    // ================= ПРОВЕРКА КУКИ =================
    async function checkCookies() {
        const cookieBtn = document.querySelector('#onetrust-accept-btn-handler') ||
                          document.querySelector('button[id*="accept"]') ||
                          findTarget(['I ACCEPT COOKIES', 'ACCEPT ALL', 'ПРИНЯТЬ', 'СОГЛАСИТЬСЯ', 'CONFIRM']);

        if (cookieBtn && isVisible(cookieBtn)) {
            log('🍪 Нажимаю кнопку принятия куки...');
            fireClick(cookieBtn);
            await sleep(2000);
            return true;
        }
        return false;
    }

    // ================= СПЕЦИАЛЬНЫЕ ДЕЙСТВИЯ =================
    
    async function doKSK() {
        if (window.location.href.includes('centreInscription')) {
            log('🏠 На странице КСК. Ищу Лес...');
            
            const forestCheckbox = document.querySelector('#foretCheckbox');
            if (forestCheckbox) { fireClick(forestCheckbox); await sleep(500); }
            else { const forestLabel = findTarget(['лес']); if (forestLabel) { fireClick(forestLabel); await sleep(500); } }

            const searchBtn = findTarget(['искать', 'search']);
            if (searchBtn) { log('🔍 Нажимаю "Искать"...'); fireClick(searchBtn); await sleep(3000); }

            let clicked = false;
            const rows = document.querySelectorAll('table tbody tr');
            for (let row of rows) {
                const buttons = row.querySelectorAll('button');
                if (buttons.length >= 3) {
                    const targetBtn = buttons[2]; // 10 дней
                    if (targetBtn && !targetBtn.disabled && targetBtn.offsetParent !== null) {
                        log(`📝 Записываю в КСК на 10 дней (цена: ${targetBtn.innerText.trim()})`);
                        fireClick(targetBtn);
                        clicked = true;
                        break;
                    }
                }
            }

            if (clicked) {
                await sleep(2000);
                await confirmModal();
                log('✅ Лошадь в КСК. Возвращаюсь...');
                window.history.back();
            } else {
                log('⚠ Не нашел доступную кнопку записи в КСК.');
            }
            return;
        }

        const isNotInKSK = document.body.innerText.includes('Зарегистрируйте свою лошадь в конноспортивном комплексе');
        if (isNotInKSK) {
            const kskBtn = document.querySelector('a[href*="centreInscription"]') || findTarget(['записать мою лошадь', 'записать']);
            if (kskBtn) { log('🏠 Переход к записи в КСК...'); fireClick(kskBtn); }
            else { log('⚠ Кнопка записи в КСК не найдена.'); }
        } else {
            log('✅ Лошадь уже в КСК.');
        }
    }

    async function doPlay(hours) {
        log(`🎮 Играть ${hours} ч...`);
        const playBtn = findTarget(['играть', 'play', 'jouer']);
        if (!playBtn) return;
        
        fireClick(playBtn);
        await sleep(1500);

        const targetStr = String(hours);
        let foundPoint = false;
        
        const modalPoints = document.querySelectorAll('.modal [data-number], [id*="play"] [data-number]');
        for (let p of modalPoints) {
            if (p.getAttribute('data-number') === targetStr && isVisible(p)) {
                fireClick(p); foundPoint = true; log(`✅ Выбрано ${hours} ч.`); break;
            }
        }

        if (!foundPoint) {
            const ranges = document.querySelectorAll('input[type="range"]');
            for (let r of ranges) {
                if (isVisible(r)) {
                    r.value = hours;
                    r.dispatchEvent(new Event('input', { bubbles: true }));
                    r.dispatchEvent(new Event('change', { bubbles: true }));
                    foundPoint = true; log(`✅ Ползунок установлен на ${hours} ч.`); break;
                }
            }
        }

        if (!foundPoint) log(`⚠ Не удалось выставить ${hours} ч.`);

        await sleep(1000);
        await confirmModal();
        await sleep(1500);
    }

    // === ПЛЯЖ ===
    async function doBeach() {
        log(`🏖 Пляж (${settings.beachHours} ч, +${settings.beachSkillUp}, -${settings.beachSkillDown})...`);
        
        const beachTab = document.querySelector('#boutonBalade-plage') || findTarget(['пляж']);
        if (!beachTab || !isVisible(beachTab)) {
            log('⚠ Вкладка "Пляж" не найдена.');
            return;
        }
        fireClick(beachTab);
        await sleep(1500);

        await setScalePoint('пляж', settings.beachHours);
        await sleep(500);

        const selects = document.querySelectorAll('select');
        for (let sel of selects) {
            if (sel.offsetParent === null) continue;
            const parentText = normalize(sel.parentElement.innerText);
            
            if (parentText.includes('улучшить')) {
                for (let opt of sel.options) {
                    if (normalize(opt.text).includes(normalize(settings.beachSkillUp))) {
                        sel.value = opt.value;
                        sel.dispatchEvent(new Event('change', { bubbles: true }));
                        log(`✅ Выбран навык для улучшения: ${opt.text}`);
                        break;
                    }
                }
            } else if (parentText.includes('ухудшить')) {
                for (let opt of sel.options) {
                    if (normalize(opt.text).includes(normalize(settings.beachSkillDown))) {
                        sel.value = opt.value;
                        sel.dispatchEvent(new Event('change', { bubbles: true }));
                        log(`✅ Выбран навык для ухудшения: ${opt.text}`);
                        break;
                    }
                }
            }
        }

        const submitBtn = document.querySelector('#walk-plage-submit') || findTarget(['прогулять']);
        if (submitBtn) {
            fireClick(submitBtn);
            await sleep(1500);
            await confirmModal();
        }
    }

    // === УМНАЯ ТРЕНИРОВКА ===
    async function doTraining() {
        const energy = getEnergyLevel();
        log(`⚡ Энергия: ${energy}%.`);

        if (energy <= 40) {
            log(`⏸ Энергия меньше 40%. Пропускаю тренировку.`);
            return;
        }

        log(`🏋️ Тренировка: ${settings.trainSkill} (${settings.trainHours} ч)...`);

        let clicked = false;
        const trainingTab = document.querySelector('#training-tab, #tab-training, .module-training');
        const searchArea = trainingTab || document.body;

        const elements = searchArea.querySelectorAll('td, div, span');
        for (let el of elements) {
            if (normalize(el.innerText).includes(normalize(settings.trainSkill)) && el.innerText.length < 50) {
                const btn = el.closest('tr')?.querySelector('a, button, .plus') || el.querySelector('a, button') || el;
                if (btn && isVisible(btn)) {
                    fireClick(btn);
                    clicked = true;
                    break;
                }
            }
        }

        if (!clicked) {
            log(`⚠ Не удалось найти кнопку для навыка "${settings.trainSkill}".`);
            return;
        }

        await sleep(1500);

        await setScalePoint('трен', settings.trainHours);
        await sleep(1000);

        const trainBtn = findTarget(['тренировать']);
        if (trainBtn) {
            fireClick(trainBtn);
            await sleep(1500);
            await confirmModal();
        } else {
            log(`⚠ Кнопка "Тренировать" не найдена.`);
        }
    }

    // === ПРОВЕРКА ПРЕДУПРЕЖДЕНИЯ О КОРМЕ ===
    function getRequiredFeedAmount(defaultAmount) {
        const messageBlocks = document.querySelectorAll('.message, .message-content, .messageBox, .info, .alert, .message-style-1');
        for (let block of messageBlocks) {
            if (!isVisible(block)) continue;
            const text = normalize(block.innerText);
            
            if (text.includes('фураж') || text.includes('корм')) {
                const match = text.match(/(\d+)\s*(фуража|корма)/);
                if (match) {
                    const requiredAmount = parseInt(match[1], 10);
                    log(`⚠ Найдено предупреждение: нужно дать ${requiredAmount} фуража!`);
                    return requiredAmount;
                }
            }
        }
        return defaultAmount;
    }

    // ================= ГЕНЕРАТОР ЗАДАЧ ПО ВОЗРАСТУ =================
    function getTasksForAge(ageInfo) {
        if (!ageInfo) return null;
        
        let tasks = [];
        
        if (ageInfo.stage === 'hours' || (ageInfo.stage === 'months' && ageInfo.months <= 4)) {
            tasks = [
                { type: 'milk', kw: ['молоко', 'milk'] },
                { type: 'groom', kw: ['чистить', 'почистить'] },
                { type: 'sleep', kw: ['спать', 'сон'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: 'Молодняк', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 6) {
            tasks = [
                { type: 'feed', amount: 6 },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '6 месяцев', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 8) {
            tasks = [
                { type: 'feed', amount: 6 },
                { type: 'play', hours: 8 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'train' }, // Тренировка перед сном
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '8 месяцев', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 10) {
            tasks = [
                { type: 'feed', amount: 6 },
                { type: 'play', hours: 10 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'train' }, // Тренировка перед сном
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '10 месяцев', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 0) {
            tasks = [
                { type: 'feed', amount: 8 },
                { type: 'play', hours: 10 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'train' },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 2) {
            tasks = [
                { type: 'feed', amount: 8 },
                { type: 'play', hours: 10 },
                { type: 'play', hours: 2 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'train' },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год 2 мес', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 4) {
            tasks = [
                { type: 'feed', amount: 8 },
                { type: 'play', hours: 8 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'train' },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год 4 мес', tasks };
        }

        return null;
    }

    // ================= ЛОГИКА =================
    async function runCycle() {
        if (!isRunning) return;
        
        try {
            // 0. ВСЕГДА ПЕРВЫМ ДЕЛОМ ПРОВЕРКА ЗДОРОВЬЯ
            const health = getHealthLevel();
            if (health < 20) {
                log(`💀 ВНИМАНИЕ! Здоровье упало до ${health}%. СРОЧНАЯ ОСТАНОВКА ПРОГРАММЫ!`);
                isRunning = false;
                updateToggle();
                return;
            }

            // 1. ПРОВЕРКА КУКИ
            await checkCookies();

            if (window.location.href.includes('centreInscription')) {
                await doKSK();
                return;
            }

            const isNotInKSK = document.body.innerText.includes('Зарегистрируйте свою лошадь в конноспортивном комплексе');
            if (isNotInKSK) {
                log('🏠 Лошадь не в КСК. Начинаю запись...');
                await doKSK();
                return; 
            }

            const ageInfo = getHorseAge();
            const stageData = getTasksForAge(ageInfo);

            if (stageData) {
                log(`🐴 Обнаружен этап: ${stageData.name}`);
                
                for (let task of stageData.tasks) {
                    if (!isRunning) return;
                    
                    if (task.type === 'play') {
                        await doPlay(task.hours);
                    } else if (task.type === 'feed') {
                        const actualFeedAmount = getRequiredFeedAmount(task.amount);
                        log(`🍎 Кормить (${actualFeedAmount} кг)...`);
                        const feedBtn = findTarget(['кормить']);
                        if (feedBtn) {
                            fireClick(feedBtn);
                            await sleep(1500);
                            await setScalePoint('корм', actualFeedAmount);
                            await sleep(500);
                            await setScalePoint('овес', actualFeedAmount); 
                            await sleep(500);
                            const giveBtn = findTarget(['дать поесть']);
                            if (giveBtn) fireClick(giveBtn);
                            await sleep(1500);
                            await confirmModal();
                        }
                    } else if (task.type === 'train') {
                        await doTraining();
                    } else {
                        const btn = findTarget(task.kw);
                        if (btn) {
                            log(`✓ ${task.kw[0]}`);
                            fireClick(btn);
                            await sleep(settings.delayAction);
                            await confirmModal();
                            await sleep(500);
                        }
                    }
                }
                
                if (settings.mode === 'run') {
                    const nextBtn = document.querySelector('#nav-next') || findTarget(['далее', 'следующая']);
                    if (nextBtn) {
                        log('➡ Переход к следующей лошади');
                        fireClick(nextBtn);
                        await sleep(3000);
                        return;
                    }
                }
            } else {
                log(`=== Взрослая лошадь (обычный режим) ===`);
                actionCount = 0;
                
                for (let act of ACTIONS_PRE) {
                    if (!isRunning) return;
                    if (!settings.enabled[act.id]) continue;
                    if (settings.mode === 'run' && ['carrot', 'mash', 'pet'].includes(act.id)) continue;

                    const btn = findTarget(act.kw);
                    if (btn) {
                        log(`✓ ${act.name}`);
                        fireClick(btn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                        await sleep(500);
                        actionCount++;
                    }
                }

                if (isRunning && settings.enabled.feed) {
                    const feedBtn = findTarget(['кормить', 'покормить', 'feed']);
                    if (feedBtn) {
                        log('Клик: Кормить');
                        fireClick(feedBtn);
                        await sleep(1500);
                        
                        const actualFeedAmount = getRequiredFeedAmount(settings.feedAmount);
                        
                        await setScalePoint('корм', actualFeedAmount);
                        await sleep(500);
                        await setScalePoint('овес', actualFeedAmount);
                        await sleep(500);
                        
                        const giveBtn = findTarget(['дать поесть', 'дать', 'feed']);
                        if (giveBtn) fireClick(giveBtn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                    }
                }

                if (isRunning && settings.enabled.walk) {
                    const walkMenuBtn = findTarget(['прогулки', 'прогулка', 'walk']);
                    if (walkMenuBtn) { fireClick(walkMenuBtn); await sleep(1000); }
                    
                    const forestBtn = document.querySelector('#buttonBalade-foret') || findTarget(['лес', 'forest']);
                    if (forestBtn && isVisible(forestBtn)) {
                        log('Клик: Лес');
                        fireClick(forestBtn);
                        await sleep(1500);
                        await setScalePoint('прогулка', settings.walkAmount);
                        await sleep(1000);
                        let confirmForest = document.querySelector('#walk-foret-submit') || findTarget(['прогулять']);
                        if (confirmForest) fireClick(confirmForest);
                        await sleep(1500);
                    }

                    const mountainBtn = document.querySelector('#buttonBalade-montagne') || findTarget(['горы', 'mountain']);
                    if (mountainBtn && isVisible(mountainBtn)) {
                        log('Клик: Горы');
                        fireClick(mountainBtn);
                        await sleep(1500);
                        await setScalePoint('прогулка', settings.walkAmount);
                        await sleep(1000);
                        let confirmMountain = document.querySelector('#walk-montagne-submit') || findTarget(['прогулять']);
                        if (confirmMountain) fireClick(confirmMountain);
                        await sleep(1500);
                    }
                }

                if (isRunning && settings.enabled.walk_beach) {
                    await doBeach();
                }

                // === ТРЕНИРОВКА (строго перед сном) ===
                if (isRunning && settings.enabled.train_action) {
                    await doTraining();
                }

                // === СОН И ВЫРАЩИВАНИЕ ===
                if (settings.mode === 'run') {
                    if (settings.enabled.next) {
                        let nextBtn = document.querySelector('#nav-next') || findTarget(['следующая', 'далее', 'next']);
                        if (nextBtn) {
                            log('➡ Переход к следующей лошади');
                            fireClick(nextBtn);
                            await sleep(3000); 
                            return; 
                        }
                    }
                } else {
                    for (let act of ACTIONS_POST) {
                        if (!isRunning) return;
                        if (!settings.enabled[act.id]) continue;
                        const btn = findTarget(act.kw);
                        if (btn) {
                            log(`✓ ${act.name}`);
                            fireClick(btn);
                            await sleep(settings.delayAction);
                            await confirmModal();
                            await sleep(500);
                        }
                    }
                }
            }
        } catch (err) {
            log(`⚠ Ошибка: ${err.message}`);
        } finally {
            if (isRunning) {
                log(`Цикл завершен. Ждем...`);
                clearTimeout(loopTimeout);
                loopTimeout = setTimeout(runCycle, settings.loopDelay);
            }
        }
    }

    function updateToggle() {
        toggleBtn.textContent = isRunning ? '■ Стоп' : '▶ Старт';
        toggleBtn.classList.toggle('running', isRunning);
        statusEl.textContent = isRunning ? 'Работает' : 'Готов';
        if (isRunning) statusDot.className = 'lp-status-dot running';
        else statusDot.className = 'lp-status-dot stopped';
        modeBtns.forEach(b => b.disabled = isRunning);
        settings.isRunning = isRunning; saveSettings();
    }

    toggleBtn.addEventListener('click', () => {
        if (isRunning) {
            isRunning = false;
            clearTimeout(loopTimeout);
            log('⏹ Остановлено пользователем');
        } else {
            isRunning = true;
            log('▶ Запуск');
            clearTimeout(loopTimeout);
            runCycle();
        }
        updateToggle();
    });

    setInterval(() => {
        if (settings.isRunning && !loopTimeout && !isRunning) {
            isRunning = true;
            updateToggle();
            runCycle();
        }
    }, 5000);

    if (settings.isRunning) {
        log('♻ Продолжаю...');
        isRunning = true;
        updateToggle();
        setTimeout(() => { if (isRunning) runCycle(); }, 2000);
    } else {
        log('v66 готов. Защита от смерти включена.');
        updateToggle();
    }
})();
