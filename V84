// ==UserScript==
// @name         Lowadi v84 (Missions & Smart Feed + Auto ID)
// @namespace    http://tampermonkey.net/
// @version      84.0
// @description  Автоматическое извлечение и проверка ID лошади из URL каждый цикл
// @author       YourName
// @match        *://*.lowadi.com/*
// @match        *://*.howrse.com/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const ACTIONS_PRE = [
        { id: 'water', name: 'Поить', kw: ['поить', 'напоить', 'water'] },
        { id: 'groom', name: 'Чистить', kw: ['чистить', 'почистить', 'groom'] },
        { id: 'carrot', name: 'Морковь', kw: ['морковь', 'carrot'] },
        { id: 'mash', name: 'Смесь', kw: ['смесь', 'mash'] },
        { id: 'pet', name: 'Ласкать', kw: ['ласкать', 'погладить', 'pet'] }
    ];

    const ACTIONS_POST = [
        { id: 'sleep', name: 'Спать', kw: ['спать', 'сон', 'отправить спать'] },
        { id: 'grow', name: 'Вырастить', kw: ['вырастить', 'grow'] }
    ];

    const DEFAULTS = {
        mode: 'train',
        feedAmount: 8,
        oatAmount: 8,
        walkAmount: 2,
        beachHours: 2,
        beachSkillUp: 'Выносливость',
        beachSkillDown: 'Прыжки',
        trainSkill: 'Рысь',
        trainHours: 3,
        kskDays: 10,
        targetAgeLimit: 25,
        delayAction: 1500, delayModal: 1000, loopDelay: 3000, isRunning: false,
        enabled: { water: true, groom: true, carrot: true, mash: true, pet: true, sleep: true, grow: true, feed: true, next: true, train_action: true, walk: true, walk_beach: true, missions: true }
    };

    function loadSettings() {
        try {
            const raw = GM_getValue('lowadiSettings_v84', '');
            if (!raw) return JSON.parse(JSON.stringify(DEFAULTS));
            const p = JSON.parse(raw);
            const m = Object.assign({}, DEFAULTS, p);
            m.enabled = Object.assign({}, DEFAULTS.enabled, p.enabled || {});
            return m;
        } catch (e) { return JSON.parse(JSON.stringify(DEFAULTS)); }
    }
    function saveSettings() { GM_setValue('lowadiSettings_v84', JSON.stringify(settings)); }
    let settings = loadSettings();

    let isRunning = settings.isRunning;
    let loopTimeout = null;
    let actionCount = 0;

    // ================= ID ЛОШАДИ =================
    // Переменная, где закрепляется ID текущей лошади.
    // Она автоматически обновляется из URL при каждой проверке.
    let currentHorseId = null;

    /**
     * Извлекает ID лошади из текущего URL.
     * Поддерживаемые форматы Lowadi/Howrse:
     *   - /horse/123456
     *   - /horse/123456/...
     *   - ?id=123456
     *   - ?horse=123456
     *   - /chevaux/123456 (фр.)
     *   - /pferde/123456 (нем.)
     *   - /caballos/123456 (исп.)
     *   - .../123456/... (число в пути)
     * Возвращает строку с ID или null, если не найдено.
     */
    function extractHorseIdFromUrl() {
        try {
            const url = window.location.href;

            // 1) Параметры query: ?id=... или ?horse=...
            const qsMatch = url.match(/[?&](?:id|horse|horse_id|chevaux|pferd|caballo)=(\d+)/i);
            if (qsMatch) return qsMatch[1];

            // 2) Путь: /horse/123456 или /chevaux/123456 и т.п.
            const pathMatch = url.match(/\/(?:horse|chevaux|pferde|pferd|caballos|caballo|cheval|horses?)\/(\d+)/i);
            if (pathMatch) return pathMatch[1];

            // 3) Любое число в пути длиной 3+ цифр (запасной вариант)
            const fallback = url.match(/\/(\d{3,})(?:\/|$|\?|#)/);
            if (fallback) return fallback[1];

            return null;
        } catch (e) {
            return null;
        }
    }

    /**
     * Обновляет/закрепляет ID лошади.
     * Если ID найден в URL — сохраняет его в currentHorseId и в GM_setValue.
     * Если не найден — пытается взять сохранённый ранее.
     * Возвращает актуальный ID (или null).
     */
    function refreshHorseId() {
        const idFromUrl = extractHorseIdFromUrl();
        if (idFromUrl) {
            if (currentHorseId !== idFromUrl) {
                log(`🆔 ID лошади закреплён из URL: ${idFromUrl}`);
            }
            currentHorseId = idFromUrl;
            GM_setValue('lowadiCurrentHorseId', idFromUrl);
            return currentHorseId;
        }
        // Если в URL не нашли — пробуем взять из сохранённого
        if (!currentHorseId) {
            const saved = GM_getValue('lowadiCurrentHorseId', '');
            if (saved) currentHorseId = saved;
        }
        return currentHorseId;
    }

    /**
     * Проверяет, что ID из URL совпадает с закреплённым.
     * Если ID изменился — обновляет закреплённую переменную и пишет в лог.
     * Возвращает true, если ID валиден (не пустой).
     */
    function checkHorseId() {
        const idFromUrl = extractHorseIdFromUrl();
        if (!idFromUrl) {
            // Если в URL нет ID — считаем, что мы на странице без лошади,
            // не сбрасываем закреплённый ID.
            return !!currentHorseId;
        }
        if (currentHorseId !== idFromUrl) {
            log(`🔄 ID сменился: ${currentHorseId || '—'} → ${idFromUrl}`);
            currentHorseId = idFromUrl;
            GM_setValue('lowadiCurrentHorseId', idFromUrl);
        }
        return true;
    }

    // ================= ПАНЕЛЬ =================
    const panel = document.createElement('div');
    panel.id = 'lp-panel';
    panel.innerHTML = `
