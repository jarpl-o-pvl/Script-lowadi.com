    async function doKSK() {
        if (window.location.href.includes('centreInscription')) {
            log(`🏠 На странице КСК. Ищу вариант на ${settings.kskDays} дней...`);

            const forestCheckbox = document.querySelector('#foretCheckbox');
            if (forestCheckbox) { fireClick(forestCheckbox); await sleep(500); }
            else { const forestLabel = findTarget(['лес']); if (forestLabel) { fireClick(forestLabel); await sleep(500); } }

            const searchBtn = findTarget(['искать', 'search']);
            if (searchBtn) { log('🔍 Нажимаю "Искать"...'); fireClick(searchBtn); await sleep(3000); }

            let clicked = false;
            let targetColIndex = -1;

            const headers = document.querySelectorAll('thead th');
            let currentIndex = 0;

            for (let th of headers) {
                const text = normalize(th.innerText);
                const colspan = parseInt(th.getAttribute('colspan') || 1, 10);

                if (text.includes(String(settings.kskDays)) ||
                   (settings.kskDays === 1 && text.includes('1 день')) ||
                   (settings.kskDays === 3 && text.includes('3 дня'))) {
                    targetColIndex = currentIndex;
                    log(`📍 Нашёл колонку для ${settings.kskDays} дней (индекс: ${targetColIndex})`);
                    break;
                }
                currentIndex += colspan;
            }

            if (targetColIndex !== -1) {
                const rows = document.querySelectorAll('tbody tr');
                for (let row of rows) {
                    const cells = row.querySelectorAll('td');
                    let cellIndex = 0;

                    for (let cell of cells) {
                        const cellColspan = parseInt(cell.getAttribute('colspan') || 1, 10);
                        if (cellIndex === targetColIndex) {
                            const btn = cell.querySelector('button');
                            if (btn && !btn.disabled && btn.offsetParent !== null) {
                                log(`📝 Записываю в КСК на ${settings.kskDays} дн. (цена: ${btn.innerText.trim()})`);
                                fireClick(btn);
                                clicked = true;
                                break;
                            }
                        }
                        cellIndex += cellColspan;
                    }
                    if (clicked) break;
                }
            }

            if (!clicked) {
                log(`⚠ Точная колонка не найдена. Ищу любую доступную кнопку...`);
                const rows = document.querySelectorAll('tbody tr');
                for (let row of rows) {
                    const btns = row.querySelectorAll('button');
                    for (let btn of btns) {
                        if (!btn.disabled && btn.offsetParent !== null && btn.textContent.length > 0) {
                            log(`📝 Нажимаю первую доступную кнопку.`);
                            fireClick(btn);
                            clicked = true;
                            break;
                        }
                    }
                    if (clicked) break;
                }
            }

            if (clicked) {
                await sleep(2000);
                await confirmModal();
                log('✅ Лошадь в КСК. Возвращаюсь...');
                window.history.back();
            } else {
                log(`⚠ Вообще не нашел ни одной кнопки записи.`);
            }
            return;
        }

        const isNotInKSK = document.body.innerText.includes('Зарегистрируйте свою лошадь в конноспортивном комплексе');
        if (isNotInKSK) {
            const kskBtn = document.querySelector('a[href*="centreInscription"]') || findTarget(['записать мою лошадь', 'записать']);
            if (kskBtn) { log('🏠 Переход к записи в КСК...'); fireClick(kskBtn); }
            else { log('⚠ Кнопка записи в КСК не найдена.'); }
        } else {
            log('✅ Лошадь уже в КСК.');
        }
    }

