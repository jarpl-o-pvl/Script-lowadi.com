    // === СЧИТЫВАНИЕ КОЛИЧЕСТВА КОРМА ИЗ ИНТЕРФЕЙСА ===
    function getRequiredFeedAmounts(defaultFeed, defaultOat) {
        let finalFeed = defaultFeed;
        let finalOat = defaultOat;

        const feedTargetEl = document.querySelector('.section-fourrage-target');
        const oatTargetEl = document.querySelector('.section-avoine-target');

        if (feedTargetEl) {
            const val = parseInt(feedTargetEl.textContent.trim(), 10);
            if (!isNaN(val)) finalFeed = val;
        }

        if (oatTargetEl) {
            const val = parseInt(oatTargetEl.textContent.trim(), 10);
            if (!isNaN(val)) finalOat = val;
        }

        if (finalFeed !== defaultFeed || finalOat !== defaultOat) {
            log(`📊 Определено из интерфейса: Корм = ${finalFeed}, Овес = ${finalOat}`);
            return { feed: finalFeed, oat: finalOat };
        }

        const messageBlocks = document.querySelectorAll('.message, .message-content, .messageBox, .info, .alert, .message-style-1');
        for (let block of messageBlocks) {
            if (!isVisible(block)) continue;
            const text = normalize(block.innerText);

            if (text.includes('фураж') || text.includes('корм')) {
                const match = text.match(/(\d+)\s*(фуража|корма)/);
                if (match) {
                    const requiredAmount = parseInt(match[1], 10);
                    const calculatedOat = Math.round(requiredAmount * 0.6);
                    log(`⚠ Найдено предупреждение: нужно дать ${requiredAmount} фуража! Ставлю ${requiredAmount} корма и ${calculatedOat} овса.`);
                    return { feed: requiredAmount, oat: calculatedOat };
                }
            }
        }

        return { feed: finalFeed, oat: finalOat };
    }

    // ================= ГЕНЕРАТОР ЗАДАЧ ПО ВОЗРАСТУ =================
    function getTasksForAge(ageInfo) {
        if (!ageInfo) return null;

        let tasks = [];

        if (ageInfo.stage === 'hours' || (ageInfo.stage === 'months' && ageInfo.months <= 4)) {
            tasks = [
                { type: 'milk', kw: ['молоко', 'milk'] },
                { type: 'groom', kw: ['чистить', 'почистить'] },
                { type: 'sleep', kw: ['спать', 'сон'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: 'Молодняк', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 6) {
            tasks = [
                { type: 'feed', amount: 6 },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '6 месяцев', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 8) {
            tasks = [
                { type: 'play', hours: 8 },
                { type: 'train' },
                { type: 'feed', amount: 6 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '8 месяцев', tasks };
        }

        if (ageInfo.stage === 'months' && ageInfo.months === 10) {
            tasks = [
                { type: 'play', hours: 10 },
                { type: 'train' },
                { type: 'feed', amount: 6 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '10 месяцев', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 0) {
            tasks = [
                { type: 'play', hours: 10 },
                { type: 'train' },
                { type: 'feed', amount: 8 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 2) {
            tasks = [
                { type: 'play', hours: 10 },
                { type: 'play', hours: 2 },
                { type: 'train' },
                { type: 'feed', amount: 8 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год 2 мес', tasks };
        }

        if (ageInfo.stage === 'years' && ageInfo.years === 1 && ageInfo.months === 4) {
            tasks = [
                { type: 'play', hours: 8 },
                { type: 'train' },
                { type: 'feed', amount: 8 },
                { type: 'pet', kw: ['ласкать'] },
                { type: 'water', kw: ['поить'] },
                { type: 'carrot', kw: ['морковь'] },
                { type: 'groom', kw: ['чистить'] },
                { type: 'sleep', kw: ['спать'] },
                { type: 'grow', kw: ['вырастить'] }
            ];
            return { name: '1 год 4 мес', tasks };
        }

        return null;
    }

    // ================= ЛОГИКА =================
    async function runCycle() {
        if (!isRunning) return;

        try {
            // === ПРОВЕРКА ID ЛОШАДИ КАЖДЫЙ ЦИКЛ ===
            checkHorseId();

            const health = getHealthLevel();
            if (health < 20) {
                log(`💀 ВНИМАНИЕ! Здоровье упало до ${health}%. СРОЧНАЯ ОСТАНОВКА ПРОГРАММЫ!`);
                isRunning = false;
                updateToggle();
                return;
            }

            if (checkAgeLimit()) {
                log(`🛑 Лошадь уже достигла возраста ${settings.targetAgeLimit} лет. Завершаю работу.`);
                isRunning = false;
                updateToggle();
                return;
            }

            await checkCookies();

            if (window.location.href.includes('centreInscription')) {
                await doKSK();
                return;
            }

            const isNotInKSK = document.body.innerText.includes('Зарегистрируйте свою лошадь в конноспортивном комплексе');
            if (isNotInKSK) {
                log('🏠 Лошадь не в КСК. Начинаю запись...');
                await doKSK();
                return;
            }

            // === МИССИИ ===
            if (settings.enabled.missions) {
                await doMissions();
            }

            if (settings.mode === 'run') {
                log(`=== Режим Прогон: базовый уход ===`);

                const preActions = ['water', 'groom', 'carrot', 'mash', 'pet'];
                for (let actId of preActions) {
                    if (!isRunning) return;
                    if (!settings.enabled[actId]) continue;
                    const act = ACTIONS_PRE.find(a => a.id === actId);
                    if (!act) continue;

                    const btn = findTarget(act.kw);
                    if (btn) {
                        log(`✓ ${act.name}`);
                        fireClick(btn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                        await sleep(500);
                    }
                }

                if (isRunning && settings.enabled.feed) {
                    const feedBtn = findTarget(['кормить', 'покормить', 'feed']);
                    if (feedBtn) {
                        log('Клик: Кормить');
                        fireClick(feedBtn);
                        await sleep(2000);

                        const amounts = getRequiredFeedAmounts(settings.feedAmount, settings.oatAmount);

                        await setScalePoint('корм', amounts.feed);
                        await sleep(1000);
                        await setScalePoint('овес', amounts.oat);
                        await sleep(1500);

                        const giveBtn = await waitForFeedButton();
                        if (giveBtn) {
                            log(`✅ Нажимаю "Дать поесть"`);
                            fireClick(giveBtn);
                        } else {
                            log(`⚠ Кнопка "Дать поесть" не найдена или неактивна.`);
                        }
                        await sleep(settings.delayAction);
                        await confirmModal();
                    }
                }

                if (isRunning && settings.enabled.sleep) {
                    const sleepBtn = findTarget(['спать', 'сон', 'отправить спать']);
                    if (sleepBtn) {
                        log('Клик: Спать');
                        fireClick(sleepBtn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                    }
                }

                if (isRunning) {
                    const nextBtn = document.querySelector('#nav-next') || findTarget(['далее', 'следующая']);
                    if (nextBtn) {
                        log('➡ Переход к следующей лошади');
                        fireClick(nextBtn);
                        await sleep(3000);
                        return;
                    }
                }
                return;
            }

            const ageInfo = getHorseAge();
            const stageData = getTasksForAge(ageInfo);

            if (stageData) {
                log(`🐴 Обнаружен этап: ${stageData.name}`);

                for (let task of stageData.tasks) {
                    if (!isRunning) return;

                    if (task.type === 'play') {
                        await doPlay(task.hours);
                    } else if (task.type === 'feed') {
                        const amounts = getRequiredFeedAmounts(task.amount, task.amount);
                        log(`🍎 Кормить (${amounts.feed} корма / ${amounts.oat} овса)...`);
                        const feedBtn = findTarget(['кормить']);
                        if (feedBtn) {
                            fireClick(feedBtn);
                            await sleep(2000);

                            await setScalePoint('корм', amounts.feed);
                            await sleep(1000);
                            await setScalePoint('овес', amounts.oat);
                            await sleep(1500);

                            const giveBtn = await waitForFeedButton();
                            if (giveBtn) {
                                log(`✅ Нажимаю "Дать поесть"`);
                                fireClick(giveBtn);
                            } else {
                                log(`⚠ Кнопка "Дать поесть" не найдена или неактивна.`);
                            }
                            await sleep(1500);
                            await confirmModal();
                        }
                    } else if (task.type === 'train') {
                        await doTraining();
                    } else if (task.type === 'grow') {
                        const btn = findTarget(task.kw);
                        if (btn) {
                            log(`✓ ${task.kw[0]}`);
                            fireClick(btn);
                            await sleep(settings.delayAction);
                            await confirmModal();
                            await sleep(1000);

                            if (checkAgeLimit()) {
                                log(`🛑 Лошадь достигла возраста ${settings.targetAgeLimit} лет. Завершаю работу.`);
                                isRunning = false;
                                updateToggle();
                                return;
                            }
                        }
                    } else {
                        const btn = findTarget(task.kw);
                        if (btn) {
                            log(`✓ ${task.kw[0]}`);
                            fireClick(btn);
                            await sleep(settings.delayAction);
                            await confirmModal();
                            await sleep(500);
                        }
                    }
                }
            } else {
                log(`=== Взрослая лошадь (обычный режим) ===`);

                if (isRunning && settings.enabled.walk) {
                    const walkMenuBtn = findTarget(['прогулки', 'прогулка', 'walk']);
                    if (walkMenuBtn) { fireClick(walkMenuBtn); await sleep(1000); }

                    const forestBtn = document.querySelector('#buttonBalade-foret') || findTarget(['лес', 'forest']);
                    if (forestBtn && isVisible(forestBtn)) {
                        log('Клик: Лес');
                        fireClick(forestBtn);
                        await sleep(1500);
                        await setScalePoint('прогулка', settings.walkAmount);
                        await sleep(1000);
                        let confirmForest = document.querySelector('#walk-foret-submit') || findTarget(['прогулять']);
                        if (confirmForest) fireClick(confirmForest);
                        await sleep(1500);
                    }

                    const mountainBtn = document.querySelector('#buttonBalade-montagne') || findTarget(['горы', 'mountain']);
                    if (mountainBtn && isVisible(mountainBtn)) {
                        log('Клик: Горы');
                        fireClick(mountainBtn);
                        await sleep(1500);
                        await setScalePoint('прогулка', settings.walkAmount);
                        await sleep(1000);
                        let confirmMountain = document.querySelector('#walk-montagne-submit') || findTarget(['прогулять']);
                        if (confirmMountain) fireClick(confirmMountain);
                        await sleep(1500);
                    }
                }

                if (isRunning && settings.enabled.walk_beach) {
                    await doBeach();
                }

                if (isRunning && settings.enabled.train_action) {
                    await doTraining();
                }

                for (let act of ACTIONS_PRE) {
                    if (!isRunning) return;
                    if (!settings.enabled[act.id]) continue;

                    const btn = findTarget(act.kw);
                    if (btn) {
                        log(`✓ ${act.name}`);
                        fireClick(btn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                        await sleep(500);
                    }
                }

                if (isRunning && settings.enabled.feed) {
                    const feedBtn = findTarget(['кормить', 'покормить', 'feed']);
                    if (feedBtn) {
                        log('Клик: Кормить');
                        fireClick(feedBtn);
                        await sleep(2000);

                        const amounts = getRequiredFeedAmounts(settings.feedAmount, settings.oatAmount);

                        await setScalePoint('корм', amounts.feed);
                        await sleep(1000);
                        await setScalePoint('овес', amounts.oat);
                        await sleep(1500);

                        const giveBtn = await waitForFeedButton();
                        if (giveBtn) {
                            log(`✅ Нажимаю "Дать поесть"`);
                            fireClick(giveBtn);
                        } else {
                            log(`⚠ Кнопка "Дать поесть" не найдена или неактивна.`);
                        }
                        await sleep(settings.delayAction);
                        await confirmModal();
                    }
                }

                for (let act of ACTIONS_POST) {
                    if (!isRunning) return;
                    if (!settings.enabled[act.id]) continue;
                    const btn = findTarget(act.kw);
                    if (btn) {
                        log(`✓ ${act.name}`);
                        fireClick(btn);
                        await sleep(settings.delayAction);
                        await confirmModal();
                        await sleep(500);
                    }
                }
            }
        } catch (err) {
            log(`⚠ Ошибка: ${err.message}`);
        } finally {
            if (isRunning) {
                log(`Цикл завершен. Ждем...`);
                clearTimeout(loopTimeout);
                loopTimeout = setTimeout(runCycle, settings.loopDelay);
            }
        }
    }

    function updateToggle() {
        toggleBtn.innerHTML = isRunning ? '<span>■ Стоп</span>' : '<span>▶ Старт</span>';
        toggleBtn.classList.toggle('running', isRunning);
        statusEl.textContent = isRunning ? 'Работает...' : 'Готов к работе';
        if (isRunning) statusDot.className = 'lp-status-dot running';
        else statusDot.className = 'lp-status-dot stopped';
        modeBtns.forEach(b => b.disabled = isRunning);
        settings.isRunning = isRunning; saveSettings();
    }

    toggleBtn.addEventListener('click', () => {
        if (isRunning) {
            isRunning = false;
            clearTimeout(loopTimeout);
            log('⏹ Остановлено пользователем');
        } else {
            // При старте — принудительно обновляем ID из URL
            refreshHorseId();
            if (currentHorseId) {
                log(`▶ Запуск (ID лошади: ${currentHorseId})`);
            } else {
                log(`▶ Запуск (ID лошади не найден в URL — работаю без привязки)`);
            }
            isRunning = true;
            clearTimeout(loopTimeout);
            runCycle();
        }
        updateToggle();
    });

    setInterval(() => {
        if (settings.isRunning && !loopTimeout && !isRunning) {
            isRunning = true;
            updateToggle();
            runCycle();
        }
    }, 5000);

    // Инициализация: сразу пытаемся захватить ID из URL
    refreshHorseId();

    if (settings.isRunning) {
        log(`♻ Продолжаю... ${currentHorseId ? '(ID: ' + currentHorseId + ')' : ''}`);
        isRunning = true;
        updateToggle();
        setTimeout(() => { if (isRunning) runCycle(); }, 2000);
    } else {
        log(`v84 готов. ${currentHorseId ? 'ID лошади: ' + currentHorseId : 'ID лошади не найден в URL.'}`);
        updateToggle();
    }
})();
